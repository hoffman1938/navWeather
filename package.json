{
  "name": "navweather",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Know the weather before you reach it \u2014 forecast along your driving route at your estimated arrival time.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node scripts/worker-assets.mjs && wrangler dev --port 8787 --ip 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev --port 8787 --ip 127.0.0.1",
    "typecheck": "tsc -b --noEmit && tsc -p worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_API_TESTS=1 vitest run src/integration/live.test.ts",
    "test:share": "node scripts/share-smoke.mjs",
    "test:reports": "node scripts/reports-smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test:trips": "node scripts/trip-smoke.mjs",
    "test:geocode": "node scripts/geocode-smoke.mjs",
    "test:route": "node scripts/route-smoke.mjs",
    "data:borders": "node pipelines/borders/build.mjs",
    "data:download": "node pipelines/osm/download.mjs",
    "data:osm": "node --experimental-strip-types --no-warnings pipelines/osm/build.mjs",
    "db:geo:local": "wrangler d1 execute navweather-geo --local --file data/build/ge/geocode.sql",
    "seed:local": "npm run data:download && npm run data:osm && npm run db:geo:local",
    "engines:up": "node scripts/engines.mjs up",
    "engines:down": "node scripts/engines.mjs down",
    "engines:status": "node scripts/engines.mjs status"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
