{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "./*.ts",
    "../src/api/v1.ts",
    "../src/share/protocol.ts",
    "../src/types/geo.ts",
    "../src/api/geocode.ts",
    "../src/api/route.ts",
    "../src/api/weather.ts",
    "../src/api/elevation.ts",
    "../src/api/air.ts",
    "../src/utils/timezone.ts"
  ]
}
