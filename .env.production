# `npm run build` (Vite mode "production") → the production Worker (`npm run deploy:production`, navweather).
# Public values only. Defaults: src/config.ts; all variables: .env.example.

# The Worker serves the app and the API from one origin.
VITE_API_ORIGIN=

# DEVELOPMENT_PLAN stage 6 (DP-6.1, gate G3) switches the public fallbacks off here once our own data cover every
# region users drive in:
# VITE_ROUTING_FALLBACK=none
# VITE_GEOCODING_FALLBACK=none
# VITE_PLACES_FALLBACK=none
# VITE_WEATHER_FALLBACK=none
