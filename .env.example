# navWeather configuration. Every value is optional — defaults live in
# src/config.ts and the app runs with no .env at all (no API keys needed).
# All VITE_* values are compiled into the public bundle: never put secrets here.
# Details: docs/ENVIRONMENT.md

# --- Providers (swap implementations without code changes) -------------------
# Roads: our Valhalla (npm run engines:up); the public OSRM servers only outside its region or without it
VITE_ROUTING_PROVIDER=valhalla
VITE_ROUTING_FALLBACK=osrm
VITE_ROUTE_URL=/api/v1/route
VITE_WEATHER_PROVIDER=open-meteo
# Search, suggestions, naming: our geocoder (DP-6.4); Photon only when our index finds nothing
VITE_GEOCODING_PROVIDER=api
VITE_AUTOCOMPLETE_PROVIDER=api
VITE_GEOCODING_FALLBACK=photon
# Places, speed limits, cameras: our tiles built by `npm run seed:local` (DEVELOPMENT_PLAN DP-6.5)
VITE_PLACES_PROVIDER=tiles
VITE_POI_PROVIDER=tiles
VITE_SPEED_LIMIT_PROVIDER=tiles
# Outside the region our tiles cover: overpass (until that region is built) or none
VITE_PLACES_FALLBACK=overpass
VITE_PLACES_TILES_URL=/data/places/v1
VITE_ELEVATION_PROVIDER=open-meteo
VITE_MAP_PROVIDER=openfreemap
# No free live traffic source exists: "none" keeps the UI honest.
VITE_TRAFFIC_PROVIDER=none
# Incidents: "reports" = driver reports through this app's Worker (/api/reports),
# always labelled unconfirmed; "none" turns them off.
VITE_INCIDENT_PROVIDER=reports
# Air quality (European AQI) for the map-centre chip and place cards; "none" to disable
VITE_AIR_QUALITY_PROVIDER=open-meteo
VITE_SPEECH_PROVIDER=browser

# --- Endpoints (free public instances — respect their usage policies) --------
VITE_OSRM_BASE_URL=https://router.project-osrm.org
# The public OSRM servers allow at most 1 request per second; 0 for your own router
VITE_OSRM_MIN_INTERVAL_MS=1000
# Walking and cycling: OpenStreetMap community routing instances (the demo server above only does cars)
VITE_OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
VITE_OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
# Public transport: Transitous (free, no key; open-source non-commercial use, link to transitous.org/sources).
# Set it empty to switch public transport off.
VITE_TRANSIT_URL=https://api.transitous.org
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com
VITE_OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
VITE_PHOTON_BASE_URL=https://photon.komoot.io
# Driver reports relay (same origin as the app; the Worker serves it)
VITE_REPORTS_URL=/api/v1/reports
# Places, speed limits, cameras outside our tiles' region (public Overpass — removed with more regions, DP-6.1)
VITE_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# If you change any host above, add it to connect-src in public/_headers too.

# --- Search ------------------------------------------------------------------
VITE_GEOCODING_LANGUAGE=en
# Nominatim policy: at most 1 request per second
VITE_NOMINATIM_MIN_INTERVAL_MS=1100
VITE_AUTOCOMPLETE_DEBOUNCE_MS=300

# --- Weather -----------------------------------------------------------------
VITE_WEATHER_CACHE_TTL_MINUTES=20
VITE_WEATHER_REFRESH_MINUTES=20
VITE_WEATHER_SPATIAL_RESOLUTION_DEG=0.02
VITE_WEATHER_BATCH_SIZE=50
VITE_WEATHER_MAX_CACHE_ENTRIES=500
VITE_WEATHER_TIMEOUT_MS=15000
VITE_WEATHER_MIN_FORECAST_HOURS=48
# Check for new forecast model runs (and refresh when one appears)
VITE_WEATHER_UPDATE_CHECK_MINUTES=10
VITE_OPEN_METEO_UPDATE_MODELS=ecmwf_ifs025,dwd_icon,ncep_gfs025

# --- Roads to choose from ------------------------------------------------------
# Distinct roads offered (best included), each with its own forecast: 1–4
VITE_ROUTE_OPTIONS_MAX=3

# --- Route sampling ------------------------------------------------------------
VITE_SAMPLE_MAX_INTERVAL_MINUTES=45
VITE_SAMPLE_MAX_REFINEMENT_POINTS=10

# --- Navigation ----------------------------------------------------------------
VITE_OFF_ROUTE_MIN_THRESHOLD_M=30
VITE_OFF_ROUTE_MAX_THRESHOLD_M=100
VITE_OFF_ROUTE_PERSIST_SECONDS=8
VITE_OFF_ROUTE_PERSIST_READINGS=3
VITE_MAX_USABLE_GPS_ACCURACY_M=100
VITE_MIN_RECALC_INTERVAL_S=20
VITE_FAR_FROM_ROUTE_M=3000

# --- Demo ----------------------------------------------------------------------
VITE_SIMULATION_DEFAULT_SPEED=60
