{
  "name": "navweather",
  "private": true,
  "version": "0.1.0",
  "description": "Know the weather before you reach it — forecast along your driving route at your estimated arrival time.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler dev --port 8787 --ip 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_API_TESTS=1 vitest run src/integration/live.test.ts",
    "test:share": "node scripts/share-smoke.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  }
}
